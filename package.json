{
  "name": "dsh-injection-manager",
  "version": "2.2.0",
  "type": "module",
  "description": "See and control everything a DeepSeek Harness session injects before its first request — prompt sections, runtime contexts, skills, tool schemas and workspace rules — with a content browser that opens each item's source, cross-session injection trends, an injection event log, health checks, suite switches, presets and a token budget.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "context",
    "injection",
    "prompt",
    "tokens",
    "budget",
    "skills",
    "tools",
    "mcp",
    "context-window",
    "compaction",
    "occupancy",
    "context-browser",
    "insights",
    "observability",
    "sessions",
    "usage",
    "ui"
  ],
  "license": "MIT",
  "author": "IWHBIWHB",
  "bugs": {
    "url": "https://github.com/IWHBIWHB/dsh-injection-manager/issues"
  },
  "scripts": {
    "test": "node --test",
    "smoke": "node scripts/smoke.mjs",
    "audit": "node scripts/self-audit.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IWHBIWHB/dsh-injection-manager.git"
  },
  "homepage": "https://github.com/IWHBIWHB/dsh-injection-manager#readme",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "scripts",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE",
    "screenshots.json",
    "CONTRIBUTING.md",
    "SECURITY.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
