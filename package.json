{
  "name": "dsh-context-injection",
  "version": "1.0.0",
  "type": "module",
  "description": "Manage what a new DSH session injects before its first request: system-prompt sections, runtime contexts, the skill catalog, tool schemas and workspace rules, with a token budget and per-item switches.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "context",
    "injection",
    "prompt",
    "tokens",
    "budget",
    "skills",
    "tools",
    "mcp"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IWHBIWHB/dsh-context-injection.git"
  },
  "homepage": "https://github.com/IWHBIWHB/dsh-context-injection#readme",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
