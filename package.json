{
  "name": "dsh-context-preflight",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Shows what a new DSH session will inject, and sets per-session defaults for skills, tool schemas and runtime context.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "context",
    "tokens",
    "budget",
    "usage",
    "skills",
    "mcp"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/IWHBIWHB/dsh-context-preflight.git"
  },
  "homepage": "https://github.com/IWHBIWHB/dsh-context-preflight#readme",
  "exports": {
    ".": {
      "default": "./index.js"
    },
    "./client": {
      "default": "./client.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg",
    "assets/*.png"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  }
}
